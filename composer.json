{
    "name": "futura/contao-snippet-elements",
    "type": "contao-bundle",
    "description": "HTML-Snippets mit Platzhaltern als wiederverwendbare Inhaltselemente für Contao 5",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Dinko Skopljak",
            "homepage": "https://futura-web.de"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.0",
        "contao/manager-plugin": "^2.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "symfony/config": "^6.0 || ^7.0",
        "symfony/dependency-injection": "^6.0 || ^7.0",
        "symfony/http-foundation": "^6.0 || ^7.0",
        "symfony/http-kernel": "^6.0 || ^7.0",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Futura\\ContaoSnippetElements\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Futura\\ContaoSnippetElements\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": true
        }
    }
}
